# Copia este archivo a .env y pon tus valores. Nunca subas .env a Git.
# Todos los valores de aquí son de ejemplo.

# Obligatoria. Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# PIN de acceso a la app. Obligatorio en producción (Render): sin él la app no arranca.
# Mejor 6 cifras o más que 4.
APP_PIN=000000

# Solo si hay más de un proxy delante de la app en producción
# PROXY_SALTOS=1

# Si se deja vacía, la app usa SQLite (database.db) en local
DATABASE_URL=

# Solo para backup.py
DB_PASSWORD=
BACKUP_DIR=C:/backups_transferencias
PG_DUMP_PATH=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe
BACKUP_DIAS=7
